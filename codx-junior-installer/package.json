{
  "name": "codx-junior-installer",
  "version": "2.0.0",
  "description": "Build and publish the codx-junior images.",
  "license": "AGPL-3.0",
  "private": true,
  "scripts": {
    "test": "bash tests/qa_suite.sh shell",
    "test:check": "bash tests/qa_suite.sh --check",
    "test:all": "bash tests/qa_suite.sh --all",
    "test:self": "bash tests/test_shell.sh --self-test",
    "build": "docker build -t codxjuniorai/codx-junior:latest -f demo/Dockerfile ..",
    "build:dind": "docker build -t codxjuniorai/codx-junior:dind -f dind/Dockerfile .",
    "publish": "cd .. && IMAGE_TAGS=latest DOCKERFILE=codx-junior-installer/demo/Dockerfile CONTEXT=. scripts/dockerhub_publish.sh",
    "publish:dind": "cd .. && IMAGE_TAGS=dind DOCKERFILE=codx-junior-installer/dind/Dockerfile CONTEXT=codx-junior-installer scripts/dockerhub_publish.sh"
  }
}
