          "response": "# client/src/api/modules/companies.js \u2014 pattern `snapshot|org_unit|team|mission` (39 match(es); 379 lines)\n```js client/src/api/modules/companies.js\n     6|  * A company is the top-level entity above projects: it owns an organization\n     7|  * (departments/functions), hybrid teams of humans **and** AI profiles, the\n     8|  * linked projects and the missions being executed. The server owns validation,\n     9|  * journaling, dispatch and autonomy; this module only shapes the requests.\n      | \u2026\n    17|  *   because some proxies drop DELETE bodies; the router accepts that form.\n    18|  * \u2022 No caching: every mutation is followed by a snapshot reload, and a short TTL\n    19|  *   would serve stale counters back.\n      | \u2026\n   112| \n   113|   /** Dashboard payload: counts, teams, projects, missions, attention, journal. */\n   114|   snapshot(companyId, { journalLimit = 30 } = {}) {\n   115|     return API.get(\n   116|       `${BASE}/${encodeURIComponent(companyId)}/snapshot${toQuery({ journal_limit: journalLimit })}`\n   117|     )\n      | \u2026\n   168| \n   169|   /** Copy the owning team roster into the hosted chat. */\n   170|   syncChatMembers(companyId, chatId) {\n      | \u2026\n   205|   addTeam(companyId, payload) {\n   206|     return API.post(`${BASE}/${encodeURIComponent(companyId)}/teams`, payload)\n   207|   },\n   208| \n   209|   updateTeam(companyId, teamId, payload) {\n   210|     return API.put(\n   211|       `${BASE}/${encodeURIComponent(companyId)}/teams/${encodeURIComponent(teamId)}`,\n   212|       payload\n      | \u2026\n   215| \n   216|   deleteTeam(companyId, teamId, { force = false } = {}) {\n   217|     return API.delete(\n   218|       `${BASE}/${encodeURIComponent(companyId)}/teams/${encodeURIComponent(teamId)}${toQuery({ force })}`\n   219|     )\n      | \u2026\n   221| \n   222|   resolveTeam(companyId, teamId) {\n   223|     return API.get(\n   224|       `${BASE}/${encodeURIComponent(companyId)}/teams/${encodeURIComponent(teamId)}`\n   225|     )\n      | \u2026\n   227| \n   228|   addTeamMembers(companyId, teamId, members) {\n   229|     return API.post(\n   230|       `${BASE}/${encodeURIComponent(companyId)}/teams/${encodeURIComponent(teamId)}/members`,\n   231|       { members }\n      | \u2026\n   234| \n   235|   removeTeamMembers(companyId, teamId, members) {\n   236|     const refs = (members || []).map(memberRef).filter(Boolean).join(',')\n   237|     return API.delete(\n   238|       `${BASE}/${encodeURIComponent(companyId)}/teams/${encodeURIComponent(teamId)}/members${toQuery({ members: refs })}`\n   239|     )\n      | \u2026\n   241| \n   242|   setTeamLead(companyId, teamId, { kind = 'profile', name = '' } = {}) {\n   243|     return API.put(\n   244|       `${BASE}/${encodeURIComponent(companyId)}/teams/${encodeURIComponent(teamId)}/lead`,\n   245|       { kind, name }\n      | \u2026\n   263|   addMission(companyId, payload) {\n   264|     return API.post(`${BASE}/${encodeURIComponent(companyId)}/missions`, payload)\n   265|   },\n   266| \n   267|   updateMission(companyId, missionId, payload) {\n   268|     return API.put(\n   269|       `${BASE}/${encodeURIComponent(companyId)}/missions/${encodeURIComponent(missionId)}`,\n   270|       payload\n      | \u2026\n   273| \n   274|   deleteMission(companyId, missionId, { force = false } = {}) {\n   275|     return API.delete(\n   276|       `${BASE}/${encodeURIComponent(companyId)}/missions/${encodeURIComponent(missionId)}${toQuery({ force })}`\n   277|     )\n      | \u2026\n   279| \n   280|   dispatchMission(companyId, missionId, { force = false } = {}) {\n   281|     return API.post(\n   282|       `${BASE}/${encodeURIComponent(companyId)}/missions/${encodeURIComponent(missionId)}/dispatch${toQuery({ force })}`,\n   283|       {}\n      | \u2026\n   286| \n   287|   acceptMission(companyId, missionId, result = '') {\n   288|     return API.post(\n   289|       `${BAS