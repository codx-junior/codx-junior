          "response": "# client/src/router/navigate.js (lines 296-360 of 651)\n```js client/src/router/navigate.js\n   296|           return homeLocation()\n   297|         }\n   298| \n   299|         try {\n   300|           await $storex.users.oauthLogin({ provider, code, state })\n   301|           return homeLocation()\n   302|         } catch (error) {\n   303|           $storex.session.onError('Failed to complete OAuth login')\n   304|           return homeLocation()\n   305|         }\n   306|       }\n   307| \n   308|       // \u2500\u2500 Unscoped root \u2192 project-scoped home \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n   309|       // Both \"/\" and \"/<project_name>\" are the WELCOME screen, which is the\n   310|       // management dashboard (see router/index.ts \u2192 WELCOME_APP). It renders\n   311|       // the same on every device, so the guard only has to scope the URL:\n   312|       // there is no per-device landing redirect to apply.\n   313|       if (to.name === 'root') {\n   314|         // The company store may not be loaded yet (login / bootstrap). The\n   315|         // App watcher and the router guard resolve it once the user exists;\n   316|         // redirecting to root here would loop on the login screen.\n   317|         const company = $storex.company?.activeCompany || $storex.company?.defaultCompany\n   318|         if (!company?.slug) return true\n   319|         return { name: 'company-home', params: { companySlug: company.slug }, replace: true }\n   320|       }\n   321| \n   322|       // The company shell is project-independent: never let the guard scope it\n   323|       // to the active project (companies orchestrate projects, not the other\n   324|       // way around).\n   325|       if (to.name === 'company-home') {\n   326|         return true\n   327|       }\n   328| \n   329|       // \u2500\u2500 Browser session route \u2192 keep the store selection in sync \u2500\u2500\n   330|       // \"/:projectName/browsers/:sessionId\" renders the browser-sessions screen,\n   331|       // which shows the session panel (live browser + docked chat) only for the\n   332|       // SELECTED session. The selection lives in the store, so a deep link or a\n   333|       // refresh on that URL must restore it from the route param.\n   334|       if ((to.name === 'browser-session' || to.name === 'computer-session') && to.params.sessionId) {\n   335|         const sessionId = String(to.params.sessionId)\n   336|         if ($storex.browsers.selectedSessionId !== sessionId) {\n   337|           $storex.browsers.selectSession(sessionId)\n   338|         }\n   339|       }\n   340| \n   341|       // \u2500\u2500 Any other named route renders as-is \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n   342|       // Single mode (every route except \".../desktop\") shows one app at a\n   343|       // time; desktop mode is the dockview workspace. The active route is the\n   344|       // single source of truth for which mode we are in (see isDesktopMode\n   345|       // above), so there is nothing left to redirect here.\n   346|       return true\n   347|     },\n   348| \n   349|     // \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n   350|     // UNIFIED APP OPEN (exposed to the UI store & components)\n   351|     // \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u25