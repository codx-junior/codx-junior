+    @staticmethod
+    def _shift_profiles(actor: str) -> List[str]:
+        """
+        Profiles of a shift card: the actor plus the agile harness tier.
+
+        The effort tier is selected by the profile NAMES of the turn, so a
+        card carrying only the actor resolves to the plain-chat policy (10
+        model rounds, no continuation) and the shift stops mid-increment.
+        The harness profile ``codx-junior`` selects the agile tier without
+        replacing the actor.
+        """
+        from codx.junior.ai.smol.effort import AGILE_PROFILE
+
+        names = [actor] if actor else []
+        if AGILE_PROFILE not in names:
+            names.append(AGILE_PROFILE)
+        return names
+
