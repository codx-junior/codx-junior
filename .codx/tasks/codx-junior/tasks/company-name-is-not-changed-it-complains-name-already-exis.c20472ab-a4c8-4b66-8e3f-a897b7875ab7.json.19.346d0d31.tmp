 profile.name.trim(),\n      description: profile.description,\n      mission: profile.mission,\n      vision: profile.vision,\n      values: profile.values.split(',').map(value => value.trim()).filter(Boolean),\n      website: profile.website\n    })\n    emit('refresh')\n    notify('Company context saved \u2713', 'success')\n  } catch (error) {\n```\n\nReplace with `const saved = await api.update(...)` + `await applySaved(saved)`.\n\nWhere to insert the new functions? Before `function ask(prompt) {` at the end of the script. Search:\n```js\nfunction ask(prompt) {\n  emit('assistant', prompt)\n}\n```\nInsert before it.\n\nAlso the watch: I'll insert `const logoDraft = ref('')` etc. after `const confirmDelete = ref(false)`.\n\nLet me write the changes.\n\nTemplate insertion: after\n```html\n          <div class=\"mt-3 grid gap-2.5 sm:grid-cols-2\">\n            <label class=\"cp-field sm:col-span-2\">\n              <span>{{ t('settings.name') }}</span>\n              <input v-model=\"profile.name\" class=\"cp-input\" :disabled=\"!canManage\" />\n            </label>\n```\nI'll insert the logo block BEFORE `<div class=\"mt-3 grid gap-2.5 sm:grid-cols-2\">`. Use search of the section header + grid start:\n\n```html\n          <div class=\"mt-3 grid gap-2.5 sm:grid-cols-2\">\n            <label class=\"cp-field sm:col-span-2\">\n              <span>{{ t('settings.name') }}</span>\n```\n\u2192\n```html\n          <!-- Logo: the mark the shell shows for this company -->\n          <div class=\"mt-3 flex items-center gap-3 rounded-xl border border-[var(--cp-border)] bg-[var(--cp-surface-soft)] p-2.5\">\n            ...\n          </div>\n\n          <div class=\"mt-3 grid gap-2.5 sm:grid-cols-2\">\n            <label class=\"cp-field sm:col-span-2\">\n              <span>{{ t('settings.name') }}</span>\n```\n\nGood \u2014 that search string is unique.\n\nNote `company` computed is available in the template.\n\nLet me write it.\n\nHmm, that was a botched batch \u2014 several of those searches were no-ops (search == replace) and one deleted `</script>`. Let me look at the current state of the script section to repair it properly.\n\nThe 5th change removed `</script>`. And change 4 replaced saveProfile with just the try opening (deleting the catch/finally). Ugh. I need to inspect and repair.\n\nLet me read the relevant part of the file: from the confirmDelete line to the end of script.\n\nI need to repair lines 295-344:\n- `saveProfile` lost its catch/finally (line 308 `} catch (error) {` then immediately `async function saveAutonomy`).\n- `</script>` is missing before `<template>`.\n\nLet me write the full correct block replacing lines 295-344 region. I'll do a single precise replacement from `async function saveProfile() {` through `\\n<template>`.\n\nSearch (exact):\n```\nasync function saveProfile() {\n  savingProfile.value = true\n  try {\n    await api.update(props.companyId, {\n      name: profile.name.trim(),\n      description: profile.description,\n      mission: profile.mission,\n      vision: profile.vision,\n      values: profile.values.split(',').map(value => value.trim()).filter(Boolean),\n      website: profile.website\n    })\n    emit('refresh')\n    notify('Company context saved \u2713', 'success')\n  } catch (error) {\n\nasync function saveAutonomy() {\n```\nReplace with the full saveProfile + logo functions + saveAutonomy opening. Better: end the search at `async function saveAutonomy() {` and start the replacement with the full saveProfile, then the logo helpers, then `async function saveAutonomy() {`.\n\nThen a second change: `}\\n\\n<template>` at the end \u2192 `}\\n</script>\\n\\n<template>`. The `function ask(prompt) { emit('assistant', prompt) }` is right before `<template>`. So search:\n```\nfunction ask(prompt) {\n  emit('assistant', prompt)\n}\n\n<template>\n```\n\u2192\n```\nfunction ask(prompt) {\n  emit('assistant', prompt)\n}\n</script>\n\n<template>\n```\n\nLet me also add the logo state refs. Where? `const confirmDelete = ref(false)` then `const company = computed(...)`. My change #2 was a no-op (search==replace) so nothing added. Let me add the logo refs now in this same call:\n\nsearch:\n```\nconst company = computed(() => props.snapshot?.company || {})\nconst autonomy = computed(() => company.value.autonomy || {})\n```\nreplace:\n```\nconst company = computed(() => props.snapshot?.company || {})\nconst autonomy = computed(() => company.value.autonomy || {})\n\n// \u2500\u2500 Branding \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// The logo is stored inline in the company document (a bounded data URL), so\n// it renders without an authenticated file endpoint and survives a reload.\nconst logoDraft = ref('')\nconst logoSaving = ref(false)\nconst logoError = ref('')\n```\n\nBut wait \u2014 is `company` defined AFTER `profile`? Order in file: `const company = computed(...)` then `const autonomy`, `counts`, `members`, then `const profile = reactive({...})`. My change #3 tried to insert after `const members...` \u2014 it was also a no-op? Change 3 search was `const members = computed(() => props.snapshot?.members || [])` and replace added `\\n\\nconst profile = reactive({` \u2014 that would DUPLICATE `const profile = reactive({`. Let me check: search was:\n```\nconst members = computed(() => props.snapshot?.members || [])\n\nconst profile = reactive({\n```\nHmm no. Looking at my call: change 3 `\"search\": \"const members = computed(() => props.snapshot?.members || [])\\n\\nconst profile = reactive({\"` \u2014 wait let me re-read what I actually sent:\n\n```\n{\"replace\": \"const members = computed(() => props.snapshot?.members || [])\", \"search\": \"const members = computed(() => props.snapshot?.members || [])\\n\\nconst profile = reactive({\"}\n```\nHmm, actually I wrote:\n- change 1: replace == search (no-op)\n- change 2: replace == search (no-op)\n- change 3: replace \"const members...\" search \"const members...\\n\\nconst profile = reactive({\"\n\nSo change 3 replaced `const members...\\n\\nconst profile = reactive({` with just `const members = computed(...)`, DELETING `const profile = reactive({`! That breaks the file \u2014 the profile object literal opening is gone.\n\nUgh. Let me read lines 30-80 to check.\n\nConfirmed: line 35-36 \u2014 `const profile = reactive({` is missing. I must restore it and add the logo refs.\n\nFix 1: replace\n```\nconst members = computed(() => props.snapshot?.members || [])\n  name: '',\n```\nwith\n```\nconst members = computed(() => props.snapshot?.members || [])\n\n// \u2500\u2500 Branding \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// The logo is stored inline in the company document (a bounded data URL), so it\n// renders without an authenticated file endpoint and survives a reload.\nconst logoDraft = ref('')\nconst logoSaving = ref(false)\nconst logoError = ref('')\n\nconst profile = reactive({\n  name: '',\n```\n\nFix 2: repair saveProfile + add logo helpers + saveAutonomy (single replacement as planned).\n\nFix 3: restore `</script>`.\n\nFix 4: template logo block.\n\nLet me do all four in ONE apply_file_changes call with 4 changes. Each must match exactly once.\n\nChange A search:\n```\nconst members = computed(() => props.snapshot?.members || [])\n  name: '',\n  description: '',\n```\nChange B search: from `async function saveProfile() {` to `  } catch (error) {\\n\\nasync function saveAutonomy() {`.\n\nChange C search:\n```\nfunction ask(prompt) {\n  emit('assistant', prompt)\n}\n\n<template>\n```\n\nChange D search: the template context grid start.\n\nLet me write the replacement for change B with all logo functions.\n\n```js\nasync function saveProfile() {\n  savingProfile.value = true\n  try {\n    const saved = await api.update(props.companyId, {\n      name: profile.name.trim(),\n      description: profile.description,\n      mission: profile.mission,\n      vision: profile.vision,\n      values: profile.values.split(',').map(value => value.trim()).filter(Boolean),\n      website: profile.website\n    })\n    await applySaved(saved)\n    notify('Company context saved \u2713', 'success')\n  } catch (error) {\n    notify(errorMessage(error), 'error')\n  } finally {\n    savingProfile.value = false\n  }\n}\n\n/**\n * Publish a saved company and follow its URL.\n *\n * The slug is the company's address: after a rename the shell must move to the\n * new one, otherwise the route keeps the old slug and the guard reopens the\n * default company (which looks like \"the name did not change\").\n *\n * @param {Object} saved Company document returned by the API.\n */\nasync function applySaved(saved) {\n  emit('refresh')\n  const slug = saved?.slug || ''\n  if (slug && slug !== company.value.slug) {\n    await router.push({ name: 'company-home', params: { companySlug: slug } }).catch(() => {})\n  }\n}\n\n/** Tell whether a stored logo value is an image source (vs a legacy icon class). */\nfunction logoIsImageSource(value) {\n  return /^(data:image\\/|https?:\\/\\/|\\/)/i.test(String(value || '').trim())\n}\n\n/** Keep the logo in sync with the company the panel is showing. */\nwatch(company, value => {\n  logoDraft.value = String(value?.logo || '')\n  logoError.value = ''\n}, { immediate: true })\n\n/**\n * Downscale an image file into a bounded data URL.\n *\n * The logo lives inline in the company document, so the file is resized first:\n * a 4 MB photo must not become a 4 MB company document. SVG is already vector\n * and small, so it is embedded as it is.\n *\n * @param {File} file Image picked by the owner.\n * @param {Number} maxSize Longest side of the stored image, in pixels.\n * @returns {Promise<String>} The data URL.\n */\nfunction downscaleImage(file, maxSize = 256) {\n  return new Promise((resolve, reject) => {\n    const reader = new FileReader()\n    reader.onerror = () => reject(new Error('Cannot read that file.'))\n    reader.onload = () => {\n      if (String(file.type) === 'image/svg+xml') {\n        resolve(String(reader.result || ''))\n        return\n      }\n      const image = new Image()\n      image.onerror = () => reject(new Error('That file is not a readable image.'))\n      image.onload = () => {\n        try {\n          const width = image.width || maxSize\n          const height = image.height || maxSize\n          const scale = Math.min(1, maxSize / Math.max(width, height))\n          const canvas = document.createElement('canvas')\n          canvas.width = Math.max(1, Math.round(width * scale))\n          canvas.height = Math.max(1, Math.round(height * scale))\n          const context = canvas.getContext('2d')\n          context.drawImage(image, 0, 0, canvas.width, canvas.height)\n          resolve(canvas.toDataURL('image/png'))\n        } catch (error) {\n          reject(error)\n        }\n      }\n      image.src = String(reader.result || '')\n    }\n    reader.readAsDataURL(file)\n  })\n}\n\n/**\n * Save (or clear) the company logo.\n *\n * @param {String} value Image URL / data URL, or '' to remove the logo.\n */\nasync function saveLogo(value) {\n  logoSaving.value = true\n  logoError.value = ''\n  try {\n    const saved = await api.update(props.companyId, { logo: value })\n    logoDraft.value = String(saved?.logo || '')\n    await applySaved(saved)\n    notify(value ? 'Company logo saved \u2713' : 'Company logo removed', 'success')\n  } catch (error) {\n    logoError.value = errorMessage(error)\n  } finally {\n    logoSaving.value = false\n  }\n}\n\n/** Owner picked a file: downscale it and store it as the company logo. */\nasync function pickLogo(event) {\n  const input = event?.target\n  const file = input?.files?.[0]\n  if (input) input.value = ''\n  if (!file) return\n  if (!String(file.type || '').startsWith('image/')) {\n    logoError.value = 'Pick an image file (png, jpeg, webp or svg).'\n    return\n  }\n  logoSaving.value = true\n  logoError.value = ''\n  try {\n    const dataUrl = await downscaleImage(file)\n    logoSaving.value = false\n    await saveLogo(dataUrl)\n  } catch (error) {\n    logoError.value = error?.message || 'Cannot read that image.'\n  } finally {\n    logoSaving.value = false\n  }\n}\n\nasync function saveAutonomy() {\n```\n\nNote: `watch` is imported? Line 2: `import { computed, onMounted, reactive, ref, watch } from 'vue'` \u2014 yes.\n\n`router` imported: `const router = useRouter()` \u2014 yes.\n\nGood. Let me apply all four changes.\n\nNow let's verify the file is syntactically sane. Let me use the client container? No, the client container is a running vite dev server maybe. Let me use a node-based check: there's `tmp-vue-sfc-check.mjs` in the client folder. Let me check the container `codx-junior-client` \u2014 it's `codxjunior/codx-junior:client`, docker exec worked? Earlier `docker_exec` on codx-junior-client failed with find /app not found and curl 000. Let's just run the script via the api container (it has node? probably not).\n\nSimplest verification: run the backend tests + check the Vue files by eye with a targeted read of the changed regions.\n\nLet me now run the python test. Test command: pytest. Let me find how tests are run. `cd api && .venv/bin/python -m pytest tests/test_company_naming.py`.\n\nNote: the test file I wrote has `os.environ.setdefault(\"CODX_JUNIOR_COMPANIES_PATH\", tempfile.mkdtemp())` at import, and a fixture