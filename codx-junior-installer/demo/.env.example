# =============================================================================
# codx-junior — DEMO settings
#
# `cp .env.example .env` and fill in ONE provider + ONE API key. Everything
# else has a working default: codx-junior configures its own provider, models
# and model slots on first start (see api/codx/junior/bootstrap.py).
#
# Full reference: README.md ("Settings" section).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. REQUIRED — the AI provider
# -----------------------------------------------------------------------------
# openai | deepseek | gemini | openrouter | mistral | groq | ollama | custom
CODX_JUNIOR_AI_PROVIDER=deepseek

# Your key. It is expanded from the environment when the provider is used, so it
# is never copied into the settings files.
CODX_JUNIOR_AI_API_KEY=

# Only for `custom` (self-hosted / OpenAI-compatible gateway) or to override the
# preset endpoint. Must include the `/v1` suffix.
# CODX_JUNIOR_AI_API_URL=https://my-gateway.example.com/v1

# -----------------------------------------------------------------------------
# 2. OPTIONAL — models (defaults are chosen per provider)
# -----------------------------------------------------------------------------
# Chat + coding model.
# CODX_JUNIOR_AI_MODEL=deepseek-chat
# Roles that should use a different model (default: the chat model).
# CODX_JUNIOR_AI_RAG_MODEL=
# CODX_JUNIOR_AI_WIKI_MODEL=
# CODX_JUNIOR_AI_GUARDRAIL_MODEL=
# Embeddings model. Empty = preset value; set to "" explicitly (or use a
# provider without an embeddings endpoint) to keep RAG disabled.
# CODX_JUNIOR_AI_EMBEDDINGS_MODEL=
# CODX_JUNIOR_AI_EMBEDDINGS_DIM=1536
# CODX_JUNIOR_AI_CONTEXT_LENGTH=32768

# -----------------------------------------------------------------------------
# 3. OPTIONAL — deployment
# -----------------------------------------------------------------------------
# Host folder that holds your projects (the only path you normally change).
CODX_JUNIOR_PROJECTS_PATH=./projects

# Port of the web UI.
CODX_JUNIOR_WEB_PORT=19981

# Public address printed when the stack starts (cloud deployments). Purely
# informational: it does not change how codx-junior binds or serves.
# CODX_JUNIOR_PUBLIC_URL=https://codx.example.com

# Pin a specific image tag (default: the published demo image).
# CODX_JUNIOR_IMAGE=codxjunior/codx-junior:demo

# 1 = hide the codx-junior internal projects from the project list.
CODX_JUNIOR_HIDDEN=0

# Re-apply the provider configuration on every start (key rotation).
# CODX_JUNIOR_AI_FORCE=0

# Disable the automatic provider configuration entirely (configure it from the
# UI instead).
# CODX_JUNIOR_AI_BOOTSTRAP=1

# -----------------------------------------------------------------------------
# 4. OPTIONAL — knowledge / RAG
# -----------------------------------------------------------------------------
# Knowledge is built in: it runs on LanceDB (embedded, on-disk, in-process), so
# there is no service to start. Only an embeddings model is needed, and the
# provider preset sets one automatically.
#
# lancedb (default, embedded) | milvus (external server) | none (disabled)
CODX_JUNIOR_KNOWLEDGE_BACKEND=lancedb

# Only used when CODX_JUNIOR_KNOWLEDGE_BACKEND=milvus, pointing at YOUR server:
# CODX_JUNIOR_MILVUS_URL=http://my-milvus:19530
