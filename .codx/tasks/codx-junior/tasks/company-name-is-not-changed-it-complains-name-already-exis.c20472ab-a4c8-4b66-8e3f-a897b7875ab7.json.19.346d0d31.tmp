s', hint: 'What the company workspace is.' },\n    36|   company: { title: 'First company', icon: 'fa-solid fa-building', hint: 'Name, purpose and brand.' },\n    37|   projects: { title: 'Projects', icon: 'fa-solid fa-diagram-project', hint: 'Repositories the company works with.' },\n    38|   models: { title: 'AI models', icon: 'fa-solid fa-brain', hint: 'Default model for the AI teams.' },\n    39|   review: { title: 'Finish', icon: 'fa-solid fa-flag-checkered', hint: 'Review and start.' }\n    40| }\n    41| \n    42| const step = ref('welcome')\n    43| const loading = ref(false)\n    44| const saving = ref(false)\n    45| const error = ref('')\n    46| const state = ref(null)\n    47| const companies = ref([])\n    48| const projectCatalog = ref([])\n    49| const models = ref([])\n    50| const modelsError = ref('')\n    51| \n    52| const form = ref({\n    53|   mode: 'new', // 'new' | 'existing'\n    54|   companyId: '',\n    55|   name: '',\n    56|   description: '',\n    57|   mission: '',\n    58|   website: '',\n    59|   color: '#6366f1',\n    60|   template: 'blank',\n    61|   projectIds: [],\n    62|   defaultModel: ''\n    63| })\n    64| \n    65| const stepIndex = computed(() => Math.max(0, STEP_ORDER.indexOf(step.value)))\n    66| const isLastStep = computed(() => step.value === 'review')\n    67| const progress = computed(() => ((stepIndex.value + 1) / STEP_ORDER.length) * 100)\n    68| const existingCompanies = computed(() => companies.value || [])\n    69| const canCreate = computed(() => form.value.name.trim().length > 1)\n    70| const stepMeta = computed(() => STEP_META[step.value] || STEP_META.welcome)\n    71| \n    72| function projectKey(item = {}) {\n    73|   return String(item.project_id || item.id || item.name || '')\n    74| }\n    75| function projectName(item = {}) {\n    76|   return item.name || item.project_name || item.path || projectKey(item)\n    77| }\n    78| function projectPath(item = {}) {\n    79|   return item.pat