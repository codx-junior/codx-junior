p role. A company\n   463|     without an owner is treated as open (fresh install / migration) so the first\n   464|     authenticated user can finish configuring it.\n   465|     \"\"\"\n   466|     if company is None:\n   467|         return COMPANY_ROLE_ADMIN\n   468|     if user and getattr(user, \"role\", \"\") == \"admin\":\n   469|         return COMPANY_ROLE_ADMIN\n   470|     username = _actor(user)\n   471|     owner = getattr(company, \"owner\", \"\") or \"\"\n   472|     if owner and owner == username:\n   473|         return COMPANY_ROLE_ADMIN\n   474|     memberships = getattr(user, \"companies\", None) or []\n   475|     membership = next(\n   476|         (\n   477|             item\n   478|             for item in memberships\n   479|             if getattr(item, \"company_id\", \"\") == getattr(company, \"id\", \"\")\n   480|         ),\n   481|         None,\n   482|     )\n   483|     if membership is not None:\n   484|         return membership.role\n   485|     return \"\"\n   486| \n   487| \n   488| def _assert_can_edit(company: Any, user: Optional[CodxUser]) -> None:\n   489|     \"\"\"\n   490|     Refuse writes from users that neither own the company nor are admins.\n   491| \n   492|     Company admins and managers may manage the work; only company admins may\n   493|     add/remove users (see ``_assert_company_admin``). A company without an owner\n   494|     is editable by any authenticated user (fresh install / migration); once it\n   495|     has one, roles are enforced.\n   496|     \"\"\"\n   497|     if company is None:\n   498|         return\n   499|     owner = getattr(company, \"owner\", \"\") or \"\"\n   500|     if not owner:\n   501|         return\n   502|     role = _company_role(company, user)\n   503|     if role in (COMPANY_ROLE_ADMIN, COMPANY_ROLE_MANAGER):\n   504|         return\n   505|     raise HTTPException(\n   506|         status_code=403,\n   507|         detail=(\n   508|             f\"Company '{company.name