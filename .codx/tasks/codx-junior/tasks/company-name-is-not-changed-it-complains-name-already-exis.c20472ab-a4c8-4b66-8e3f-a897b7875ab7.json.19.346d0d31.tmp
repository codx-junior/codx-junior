          "response": "# client/src/api/modules/companies.js (lines 1-354 of 379)\n```js client/src/api/modules/companies.js\n     1| /**\n     2|  * Companies API module.\n     3|  *\n     4|  * Thin client over `/api/companies/*` (see `codx/junior/api/company.py`).\n     5|  *\n     6|  * A company is the top-level entity above projects: it owns an organization\n     7|  * (departments/functions), hybrid teams of humans **and** AI profiles, the\n     8|  * linked projects and the missions being executed. The server owns validation,\n     9|  * journaling, dispatch and autonomy; this module only shapes the requests.\n    10|  *\n    11|  * Notes\n    12|  * -----\n    13|  * \u2022 Company endpoints are global (not project-scoped). The API layer still\n    14|  *   appends `codx_path` to every request, which the backend ignores for these\n    15|  *   routes.\n    16|  * \u2022 `DELETE` membership is sent as a comma separated `members` query parameter\n    17|  *   because some proxies drop DELETE bodies; the router accepts that form.\n    18|  * \u2022 No caching: every mutation is followed by a snapshot reload, and a short TTL\n    19|  *   would serve stale counters back.\n    20|  */\n    21| \n    22| const BASE = '/api/companies'\n    23| \n    24| /**\n    25|  * Build a query string, skipping empty values.\n    26|  * @param {Object} params\n    27|  * @returns {string} `?a=1&b=2` or `''`.\n    28|  */\n    29| function toQuery(params = {}) {\n    30|   const search = new URLSearchParams()\n    31|   Object.entries(params).forEach(([key, value]) => {\n    32|     if (value === undefined || value === null || value === '') return\n    33|     search.set(key, String(value))\n    34|   })\n    35|   const query = search.toString()\n    36|   return query ? `?${query}` : ''\n    37| }\n    38| \n    39| /** Join a member reference the backend understands. */\n    40| export function memberRef(member) {\n    41|   if (!member) return ''\n    42|   if (typeof member === 'string') return member\n    43|   return `${member.kind || 'profile'}:${member.name || ''}`\n    44| }\n    45| \n    46| export const companiesModule = (API) => ({\n    47|   // \u2500\u2500 Companies \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    48| \n    49|   /** List every company (summary payload). */\n    50|   list({ includeArchived = true } = {}) {\n    51|     return API.get(`${BASE}${toQuery({ include_archived: includeArchived })}`)\n    52|   },\n    53| \n    54|   /** Discovered projects, users and AI profiles for the pickers. */\n    55|   references({ projectId } = {}) {\n    56|     return API.get(`${BASE}/references${toQuery({ project_id: projectId })}`)\n    57|   },\n    58| \n    59|   /**\n    60|    * Installation onboarding (the \"New company\" wizard): stored state, the\n    61|    * step catalog, the companies that can be configured and `needs_setup`.\n    62|    */\n    63|   onboarding() {\n    64|     return API.get(`${BASE}/onboarding`)\n    65|   },\n    66| \n    67|   /**\n    68|    * Advance, skip or finish the wizard, or `{ reset: true }` to run it again.\n    69|    * Settings collected in the wizard (`default_model`\u2026) are merged server side.\n    70|    */\n    71|   saveOnboarding(payload = {}) {\n    72|     return API.post(`${BASE}/onboarding`, payload)\n    73|   },\n    74| \n    75|   /** One company document. */\n    76|   get(companyId) {\n    77|     return API.get(`${BASE}/${encodeURIComponent(companyId)}`)\n    78|   },\n    79| \n    80|   /**\n    81|    * Companies that can see a project. Used to resolve legacy\n    82|    * `/<project>/...` URLs to the canonical company workspace URL.\n 