          "response": "# api/codx/junior/company/store.py (lines 120-370 of 392)\n```py api/codx/junior/company/store.py\n   120|         raise\n   121| \n   122| \n   123| class CompanyStore:\n   124|     \"\"\"\n   125|     Read/write companies and their journals.\n   126| \n   127|     Args:\n   128|         root_path: Companies root. Defaults to :func:`get_companies_root`.\n   129|     \"\"\"\n   130| \n   131|     def __init__(self, root_path: Optional[str] = None):\n   132|         self.root_path = os.path.abspath(\n   133|             os.path.expanduser(root_path or get_companies_root())\n   134|         )\n   135|         self._locks: Dict[str, threading.RLock] = {}\n   136|         self._locks_guard = threading.Lock()\n   137| \n   138|     # -- paths -------------------------------------------------------------\n   139| \n   140|     def company_dir(self, company_id: str) -> str:\n   141|         \"\"\"\n   142|         Return the folder of a company.\n   143| \n   144|         The id is validated before touching the filesystem: an id containing a\n   145|         path separator could escape the root.\n   146| \n   147|         Args:\n   148|             company_id: Company id.\n   149| \n   150|         Returns:\n   151|             Absolute folder path.\n   152| \n   153|         Raises:\n   154|             ValueError: If the id is empty, ``.``/``..`` or contains a separator.\n   155|         \"\"\"\n   156|         company_id = (company_id or \"\").strip()\n   157|         if (\n   158|             not company_id\n   159|             or company_id in (\".\", \"..\")\n   160|             or \"/\" in company_id\n   161|             or \"\\\\\" in company_id\n   162|         ):\n   163|             raise ValueError(f\"invalid company id: {company_id!r}\")\n   164|         return os.path.join(self.root_path, company_id)\n   165| \n   166|     def company_path(self, company_id: str) -> str:\n   167|         \"\"\"Return the path of the ``company.json`` document.\"\"\"\n   168|         return os.path.join(self.company_dir(company_id), COMPANY_FILE)\n   169| \n   170|     def journal_path(self, company_id: str) -> str:\n   171|         \"\"\"Return the path of the append-only journal.\"\"\"\n   172|         return os.path.join(self.company_dir(company_id), JOURNAL_FILE)\n   173| \n   174|     # -- existence / listing ----------------------------------------------\n   175| \n   176|     def exists(self, company_id: str) -> bool:\n   177|         \"\"\"Tell whether a company document exists.\"\"\"\n   178|         try:\n   179|             return os.path.isfile(self.company_path(company_id))\n   180|         except ValueError:\n   181|             return False\n   182| \n   183|     def list_ids(self) -> List[str]:\n   184|         \"\"\"\n   185|         List every company id stored under the root.\n   186| \n   187|         Returns:\n   188|             Company ids sorted by folder modification time (newest first), then\n   189|             name for a stable order.\n   190|         \"\"\"\n   191|         if not os.path.isdir(self.root_path):\n   192|             return []\n   193|         entries: List[tuple] = []\n   194|         for name in os.listdir(self.root_path):\n   195|             if not os.path.isfile(os.path.join(self.root_path, name, COMPANY_FILE)):\n   196|                 continue\n   197|             try:\n   198|                 mtime = os.path.getmtime(os.path.join(self.root_path, name))\n   199|             except OSError:\n   200|                 mtime = 0.0\n   201|             entries.append((mtime, name))\n   202|         entries.sort(key=lambda entry: (-entry[0], entry[1]))\n   203|         return [name for _, name in entries]\n   204| \n   205|     # -- reads / writes ----------------------------------------------------\n   206| \n   207|     def load(self, company_id: str) -> Company:\n   208|         \"\"\"\n   209|         Load one company.\n   210| \n   211|         Args:\n   212|          