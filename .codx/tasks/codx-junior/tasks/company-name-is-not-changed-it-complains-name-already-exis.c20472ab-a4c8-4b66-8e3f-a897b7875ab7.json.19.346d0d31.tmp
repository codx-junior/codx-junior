          "response": "# client/src/components/company/CompanySettings.vue (lines 340-435 of 859)\n```vue client/src/components/company/CompanySettings.vue\n   340| \n   341| /** Tell whether a stored logo value is an image source (vs a legacy icon class). */\n   342| function logoIsImageSource(value) {\n   343|   return /^(data:image\\/|https?:\\/\\/|\\/)/i.test(String(value || '').trim())\n   344| }\n   345| \n   346| /** Keep the logo draft in sync with the company the panel is showing. */\n   347| watch(company, value => {\n   348|   logoDraft.value = String(value?.logo || '')\n   349|   logoError.value = ''\n   350| }, { immediate: true })\n   351| \n   352| /**\n   353|  * Downscale an image file into a bounded data URL.\n   354|  *\n   355|  * The logo lives inline in the company document, so the file is resized first: a\n   356|  * multi-megabyte photo must not become a multi-megabyte company document. SVG is\n   357|  * already vector and small, so it is embedded as it is.\n   358|  *\n   359|  * @param {File} file Image picked by the owner.\n   360|  * @param {Number} maxSize Longest side of the stored image, in pixels.\n   361|  * @returns {Promise<String>} The data URL.\n   362|  */\n   363| function downscaleImage(file, maxSize = 256) {\n   364|   return new Promise((resolve, reject) => {\n   365|     const reader = new FileReader()\n   366|     reader.onerror = () => reject(new Error('Cannot read that file.'))\n   367|     reader.onload = () => {\n   368|       if (String(file.type) === 'image/svg+xml') {\n   369|         resolve(String(reader.result || ''))\n   370|         return\n   371|       }\n   372|       const image = new Image()\n   373|       image.onerror = () => reject(new Error('That file is not a readable image.'))\n   374|       image.onload = () => {\n   375|         try {\n   376|           const width = image.width || maxSize\n   377|           const height = image.height || maxSize\n   378|           const scale = Math.min(1, maxSize / Math.max(width, height))\n   379|           const canvas = document.createElement('canvas')\n   380|           canvas.width = Math.max(1, Math.round(width * scale))\n   381|           canvas.height = Math.max(1, Math.round(height * scale))\n   382|           const context = canvas.getContext('2d')\n   383|           context.drawImage(image, 0, 0, canvas.width, canvas.height)\n   384|           resolve(canvas.toDataURL('image/png'))\n   385|         } catch (error) {\n   386|           reject(error)\n   387|         }\n   388|       }\n   389|       image.src = String(reader.result || '')\n   390|     }\n   391|     reader.readAsDataURL(file)\n   392|   })\n   393| }\n   394| \n   395| /**\n   396|  * Save (or clear) the company logo.\n   397|  *\n   398|  * @param {String} value Image URL or data URL; an empty string removes it.\n   399|  */\n   400| async function saveLogo(value) {\n   401|   logoSaving.value = true\n   402|   logoError.value = ''\n   403|   try {\n   404|     const saved = await api.update(props.companyId, { logo: value })\n   405|     logoDraft.value = String(saved?.logo || '')\n   406|     await applySaved(saved)\n   407|     notify(value ? 'Company logo saved \u2713' : 'Company logo removed', 'success')\n   408|   } catch (error) {\n   409|     logoError.value = errorMessage(error)\n   410|   } finally {\n   411|     logoSaving.value = false\n   412|   }\n   413| }\n   414| \n   415| /** Owner picked a file: downscale it and store it as the company logo. */\n   416| async function pickLogo(event) {\n   417|   const input = event?.target\n   418|   const file = input?.files?.[0]\n   419|   if (input) input.value = ''\n   420|   if (!file) return\n   421|   if (!String(file.type || '').startsWith('image/')) {\n   422|     logoError.value = 'Pick an image file (png, jpeg, webp or svg).'\n   423|     return\n   424|   }\n   425|   logoError.value = ''\n   426|   let dataUrl = ''\n   427|   try {\n   428|     dataUrl = await downscaleImage(file)\n   429|   } catch (error) {\n   430|     logoError.value = error?.message || 'Cannot read that image.'\n   431|     return\n",
