# Copy to .env (or export in CI) and fill in the token.
# Never commit real credentials: DOCKERHUB_TOKEN must be a CI/project secret.

# New Docker Hub home: https://hub.docker.com/u/codxjuniorai
DOCKERHUB_NAMESPACE=codxjuniorai
DOCKERHUB_USER=codxjuniorai
# Read/write access token from Docker Hub > Account settings > Personal access tokens
DOCKERHUB_TOKEN=
DOCKERHUB_REGISTRY=docker.io

# Image coordinates
IMAGE_NAME=codx-junior
# Comma separated tags pushed from the same build
IMAGE_TAGS=latest

# Build inputs
DOCKERFILE=Dockerfile
CONTEXT=.
BUILD_TARGET=
# Space separated --build-arg pairs
BUILD_ARGS=

# One manifest list covering amd64 and arm64 hosts
PLATFORMS=linux/amd64,linux/arm64

PUSH=true
BUILD=true
NO_CACHE=false
PULL=false
DRY_RUN=false
# METADATA_FILE=.codx/dockerhub-build-metadata.json
